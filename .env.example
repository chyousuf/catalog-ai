# CatalogAI Server Environment Configuration
# Copy this file to .env.local to configure your Gemini API key

# Google Gemini API Key (obtained from https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# When GEMINI_API_KEY is not provided, CatalogAI automatically uses its built-in
# context-aware offline generation engine with strict anti-hallucination guardrails.
